# ============================================================
# Plantilla de variables de entorno — SÍ se versiona
# Copiar a .env y rellenar los valores reales:
#   cp .env.example .env
# Nunca subas .env al repositorio.
# ============================================================

# Contraseña del usuario root de MySQL
MYSQL_ROOT_PASSWORD=cambia_esto_por_una_clave_larga

# Base de datos y usuario de la aplicación
MYSQL_DATABASE=mibodega
MYSQL_USER=bodega
MYSQL_PASSWORD=cambia_esto_por_una_clave_larga

# Puerto publicado en localhost (no en 0.0.0.0)
MYSQL_PORT=3306

# Zona horaria del contenedor
TZ=America/Lima
